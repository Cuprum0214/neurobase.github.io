      "emotion-limbic-system",
      "emotion-amygdala",
      "emotion-insula"
    ],
    "engineering_link": "基本情绪标签是情感计算中最常用的分类体系（如 DEAP 数据集的效价/唤醒维度与情绪标签），直接决定情绪识别模型的目标空间。",
    "references": [
      {
        "type": "encyclopedia",
        "title": "认知心理学 (Sternberg & Sternberg, 7th ed.)",
        "verified_at": "2026-10-10"
      }
    ],
    "updated_at": "2026-10-10T00:00:00Z"
  },
  {
    "id": "emotion-emotion-regulation",
    "module": "emotion",
    "name_zh": "情绪调节",
    "name_en": "Emotion Regulation",
