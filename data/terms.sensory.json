  {
    "id": "sensory-lateral-geniculate-nucleus",
    "module": "sensory",
    "name_zh": "外侧膝状体",
    "name_en": "Lateral Geniculate Nucleus",
    "aliases": [
      "LGN",
      "外膝体"
    ],
    "definition": "丘脑中的视觉中继核团，接收视网膜投射并按眼与视野分层重组，再投射到初级视皮层，同时受皮层反馈调制。",
    "plain": "视觉信号的“中转站”：把两只眼睛的线路重新排好，再送去皮层。",
    "difficulty": "intermediate",
    "tags": [
      "视觉",
      "丘脑"
    ],
    "related": [
      "sensory-visual-pathway",
      "anatomy-thalamus",
      "sensory-visual-cortex"
    ],
    "engineering_link": "LGN 的反馈调制说明感觉中继不是被动转发，而是带先验的主动滤波。",
    "references": [
      {
        "type": "textbook",
        "title": "Principles of Neural Science (Kandel et al., 6th ed., 2021)",
        "verified_at": "2026-11-20"
      }
    ],
    "pinyin": "waicexizhuangti",
    "pinyin_initials": "wcxzt",
    "updated_at": "2026-11-20T00:00:00Z"
  },
  {
    "id": "sensory-cochlea",
    "module": "sensory",
    "name_zh": "耳蜗",
    "name_en": "Cochlea",
    "aliases": [
      "耳蜗管",
      "蜗牛壳"
    ],
    "definition": "内耳的螺旋形听觉器官，基底膜按频率位置化分解声音，毛细胞把机械振动转换为电信号。",
    "plain": "耳朵里的“钢琴键盘”：不同位置负责不同音高，声音进来就被拆成频谱。",
    "difficulty": "intro",
    "tags": [
      "听觉",
      "内耳"
