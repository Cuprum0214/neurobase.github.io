[
  {
    "id": "anatomy-cerebral-cortex",
    "module": "anatomy",
    "name_zh": "大脑皮层",
    "name_en": "Cerebral Cortex",
    "aliases": [
      "皮层",
      "皮质",
      "大脑皮质",
      "cortex"
    ],
    "pinyin": "danaopiceng",
    "pinyin_initials": "dnpc",
    "definition": "位于大脑半球表面、由分层神经元构成的灰质结构（厚约 2–4 mm），是感觉、运动、语言与高级认知功能的主要皮层基础；按细胞构筑可分为 6 层，并划分为不同的 Brodmann 区。",
    "plain": "大脑最外层那张“皱褶工作台”，高级功能基本都在这儿完成。",
    "difficulty": "intro",
    "tags": [
      "脑区",
      "皮层"
    ],
    "related": [
      "anatomy-prefrontal-cortex",
      "motor-primary-motor-cortex",
      "anatomy-broca-area"
    ],
    "engineering_link": "EEG/MEG 的主要信号源是皮层锥体细胞群的同步突触后电位，理解皮层分层有助于解释脑电的空间特性。",
    "references": [
      {
        "type": "textbook",
        "title": "Principles of Neural Science (Kandel et al., 6th ed., 2021)",
        "verified_at": "2026-10-10"
      }
    ],
    "updated_at": "2026-10-10T00:00:00Z"
  },
  {
    "id": "anatomy-corpus-callosum",
    "module": "anatomy",
    "name_zh": "胼胝体",
    "name_en": "Corpus Callosum",
