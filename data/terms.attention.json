    "updated_at": "2026-11-20T00:00:00Z"
  },
  {
    "id": "attention-feature-integration",
    "module": "attention",
    "name_zh": "特征整合理论",
    "name_en": "Feature Integration Theory",
    "aliases": [
      "特征整合论",
      "FIT"
    ],
    "definition": "Treisman 提出的理论：颜色、朝向等特征先被并行、独立编码为特征地图，注意再把它们绑定为完整客体，绑定失败可导致错觉性结合。",
    "plain": "先分头记录“颜色、形状、位置”，再由注意力把它们缝成一个完整的东西。",
    "difficulty": "intermediate",
    "tags": [
      "注意",
      "理论",
      "绑定"
    ],
    "related": [
      "attention-feature-binding",
      "attention-visual-search",
      "attention-selective-attention"
    ],
    "engineering_link": "特征地图 + 绑定机制对应目标检测中的特征金字塔与注意力聚合。",
    "references": [
      {
        "type": "textbook",
        "title": "Cognitive Neuroscience: The Biology of the Mind (Gazzaniga et al., 5th ed., 2018)",
        "verified_at": "2026-11-20"
      }
    ],
    "pinyin": "tezhengzhenghelilun",
    "pinyin_initials": "tzzhll",
    "updated_at": "2026-11-20T00:00:00Z"
  },
  {
    "id": "attention-inhibition-of-return",
    "module": "attention",
    "name_zh": "返回抑制",
    "name_en": "Inhibition of Return",
    "aliases": [
      "IOR",
      "返回抑制效应"
    ],
    "definition": "注意从已被线索化位置撤离后，该位置在数百毫秒内反应变慢的现象，被认为促进搜索中新位置的探索。",
    "plain": "看过的地方“暂时不想再看”，逼着注意力去扫新的角落。",
    "difficulty": "intermediate",
    "tags": [
      "注意",
      "空间"
    ],
    "related": [
      "attention-spatial-cueing",
      "attention-visual-search",
      "attention-orienting"
    ],
    "engineering_link": "返回抑制等价于搜索中的“已访问抑制”，可提升覆盖效率。",
    "references": [
      {
        "type": "textbook",
        "title": "Cognitive Neuroscience: The Biology of the Mind (Gazzaniga et al., 5th ed., 2018)",
        "verified_at": "2026-11-20"
      }
    ],
    "pinyin": "fanhuiyizhi",
    "pinyin_initials": "fhyz",
    "updated_at": "2026-11-20T00:00:00Z"
  },
  {
