      "空间"
    ],
    "related": [
      "attention-spatial-cueing",
      "attention-attention-network",
      "attention-inhibition-of-return"
    ],
    "engineering_link": "定向机制对应主动感知中的传感器指向与感兴趣区域选择。",
    "references": [
      {
        "type": "textbook",
        "title": "Cognitive Neuroscience: The Biology of the Mind (Gazzaniga et al., 5th ed., 2018)",
