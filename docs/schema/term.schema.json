{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://neurobase.local/schema/term.schema.json",
  "title": "NeuroBase Term",
  "description": "NeuroBase 词条数据模型（Phase 0 冻结 v1.0）。字段变更须更新版本号并同步 PLAN.md §3.2。",
  "type": "object",
  "required": ["id", "module", "name_zh", "definition", "difficulty", "references", "updated_at"],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)+$",
      "description": "稳定唯一标识，格式 module-slug，如 bci-p300"
    },
    "module": {
      "type": "string",
      "enum": [
        "neuron",
        "synapse",
        "anatomy",
        "sensory",
        "motor",
        "attention",
        "memory",
        "language",
        "emotion",
        "methods",
        "bci"
      ],
      "description": "所属知识模块（11 模块，见 PLAN.md §2.2）"
    },
    "name_zh": { "type": "string", "minLength": 1, "description": "中文名" },
    "name_en": { "type": "string", "description": "英文名" },
    "abbr": { "type": "string", "description": "英文缩写，如 EEG / P300" },
    "aliases": {
      "type": "array",
      "items": { "type": "string" },
      "description": "别名 / 旧称 / 同义词，用于检索命中"
    },
    "pinyin": { "type": "string", "description": "中文名全拼（小写连写、无空格与声调），用于拼音检索" },
    "pinyin_initials": {
      "type": "string",
      "pattern": "^[a-z]+$",
      "description": "中文名逐字拼音首字母（小写连写），如“树突”→ st；用于首字母检索"
    },
    "definition": { "type": "string", "minLength": 1, "description": "学术定义（严谨表述）" },
    "plain": { "type": "string", "description": "生活化类比（科普解释）" },
    "figure": { "type": "string", "description": "示意图路径（相对 public/），如 assets/figures/bci-p300.svg" },
    "video": { "type": "string", "description": "短视频 / 动画外链 URL" },
    "difficulty": {
      "type": "string",
      "enum": ["intro", "intermediate", "advanced"],
      "description": "难度分级"
    },
    "tags": { "type": "array", "items": { "type": "string" }, "description": "检索标签" },
    "related": {
      "type": "array",
      "items": { "type": "string" },
      "description": "相关词条 id 列表（用于互跳）"
    },
    "engineering_link": {
      "type": "string",
      "description": "神经科学↔工程对照：该概念的采集/解码/应用环节"
    },
    "references": {
      "type": "array",
      "minItems": 1,
      "description": "来源登记（可溯要求，至少 1 条）",
      "items": {
        "type": "object",
        "required": ["type", "title", "verified_at"],
        "additionalProperties": false,
        "properties": {
          "type": {
            "type": "string",
            "enum": ["textbook", "review", "paper", "official", "encyclopedia", "lecture"],
            "description": "来源类型"
          },
          "title": { "type": "string", "minLength": 1 },
          "authors": { "type": "string" },
          "year": { "type": "integer" },
          "url": { "type": "string", "description": "可核验链接（来源类型为 official 时建议必填）" },
          "doi": { "type": "string" },
          "verified_at": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$", "description": "核验日期 ISO" }
        }
      }
    },
    "updated_at": {
      "type": "string",
      "format": "date-time",
      "description": "词条最后更新时间戳（ISO 8601）"
    }
  }
}
